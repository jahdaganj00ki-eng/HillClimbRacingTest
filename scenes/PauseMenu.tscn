theme_override_font_sizes/normal = 24

[node name="BtnMainMenu" name="%BtnMainMenu" type="Button" parent="PauseContent" layout_mode=3]
custom_minimum_size = Vector2(300, 60)
text = "MAIN MENU"
theme_override_theme = SubResource("ButtonTheme")
