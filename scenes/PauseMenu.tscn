[node name="PauseMenu" type="Panel" layout_mode=3]
script = ExtResource("1_pause_menu")
anchors_preset = 15
theme_override_styles/panel = SubResource("StyleBoxFlat_pause_bg")

[node name="PauseContent" type="VBoxContainer" parent="." layout_mode=3]
anchors_preset = 15
offset_left = -150
offset_top = -100
offset_right = 150
offset_bottom = 100
alignment = 1
separation = 20

[node name="PauseTitle" type="Label" parent="PauseContent" layout_mode=3]
horizontal_alignment = 1
text = "PAUSED"
theme_override_font_sizes/normal = 48
theme_override_colors/font_color = Color(1, 0.9, 0.2, 1)

[node name="BtnResume" name="%BtnResume" type="Button" parent="PauseContent" layout_mode=3]
custom_minimum_size = Vector2(300, 60)
text = "RESUME (ESC)"
theme_override_theme = SubResource("ButtonTheme")
theme_override_font_sizes/normal = 24

[node name="BtnRestart" name="%BtnRestart" type="Button" parent="PauseContent" layout_mode=3]
custom_minimum_size = Vector2(300, 60)
